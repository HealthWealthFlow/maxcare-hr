# ===== Backend (server/index.js) — manager 2FA =====
# The manager login is verified server-side. The 4-digit code is generated & checked
# on the backend, then emailed to EMAIL_TO — never exposed in the browser.
PORT=3001
# Manager credentials used to sign in (form = email + password).
MANAGER_EMAIL="manager@maxcare.com.my"
MANAGER_PASSWORD="maxcare123"
# Who receives the verification code.
EMAIL_TO="maxcarepharmacy99@gmail.com"

# ---- Email delivery (Resend) ----
# Get an API key at https://resend.com and verify the "from" domain.
# Leave RESEND_API_KEY empty to log the code to the server console instead.
RESEND_API_KEY=""
RESEND_FROM="Maxcare Pharmacy <onboarding@resend.dev>"

OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
# 2FA for manager login. Leave false/empty for local dev (signs straight in).
# Set true before publishing (or it auto-ONs when NODE_ENV=production).
REQUIRE_2FA="false"

# ===== DeepSeek AI Assistant (manager portal chatbox) =====
# Read by the server (server/index.js) only — it never ships to the browser.
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=""

# Optional: OAuth/API keys for AI Studio are not required to run this app.
GEMINI_API_KEY=""
APP_URL=""

# ===== Google Sheets backend (shared data store) =====
# Paste the deployed Apps Script Web App /exec URL (see apps-script/README.md).
# Leave empty to keep data in the browser (localStorage) instead.
VITE_SHEETS_API_URL=""
